{
  "name": "hearth-dashboard",
  "version": "0.2.1",
  "private": true,
  "description": "A modular, widget-based, kiosk-friendly Home Assistant dashboard card (HACS).",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "demo": "rollup -c --environment DEMO",
    "version": "node scripts/sync-version.mjs && npm run build && git add src/version.ts CHANGELOG.md dist",
    "postversion": "git push --follow-tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therealcarnivor/HA-Dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/therealcarnivor/HA-Dashboard/issues"
  },
  "homepage": "https://github.com/therealcarnivor/HA-Dashboard#readme",
  "keywords": [
    "home-assistant",
    "hacs",
    "lovelace",
    "dashboard",
    "kiosk"
  ],
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "rollup": "^4.67.5",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3"
  }
}
